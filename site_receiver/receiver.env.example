# Site receiver configuration (see site_receiver/README.md and docs/BODYCAM_OFFLINE_TRANSPORT.md).
# Copy to a file readable only by the service account. NEVER put real secrets in this example.

# Identity of the site this receiver serves (from the control room's site page).
RECEIVER_SITE_ID=00000000-0000-0000-0000-000000000000
RECEIVER_SITE_CODE=SITE-CODE
RECEIVER_NAME=site-receiver-1

# Control room (HTTPS). The credential is created in the control room: Site > Video transfer > Add receiver.
RECEIVER_CENTRAL_URL=https://control-room.example
RECEIVER_CENTRAL_TOKEN_FILE=/etc/bodycam-receiver/central.token
# Private CA for the control room's certificate, if it is not publicly trusted:
# RECEIVER_CENTRAL_CA_FILE=/etc/bodycam-receiver/ca.pem

# The control room's grant PUBLIC key (verification only) and, optionally, the pinned key id.
RECEIVER_GRANT_PUBLIC_KEY_FILE=/etc/bodycam-receiver/grant_public.pem
RECEIVER_GRANT_ISSUER=sp-bodycam-control-room
# RECEIVER_GRANT_KEY_ID=

# Secrets for phone sessions and operator access (long random values).
RECEIVER_ACCESS_TOKEN_SECRET_FILE=/etc/bodycam-receiver/session.secret
RECEIVER_ADMIN_KEY_FILE=/etc/bodycam-receiver/admin.key

# Storage: <root>/<site_id>/<recording_id>/<chunk_id>.mp4 ; keep the database on the same durable disk.
RECEIVER_STORAGE_ROOT=/var/lib/bodycam-receiver/media
RECEIVER_DB_PATH=/var/lib/bodycam-receiver/receiver.sqlite3
RECEIVER_MAX_CHUNK_MB=100
# Stop accepting uploads when free space falls below this.
RECEIVER_MIN_FREE_MB=2048
RECEIVER_UPLOAD_CONCURRENCY=8
RECEIVER_FORWARD_CONCURRENCY=2
RECEIVER_BACKOFF_BASE_SECONDS=5
RECEIVER_BACKOFF_MAX_SECONDS=900
RECEIVER_MAX_HARD_ERRORS=10
RECEIVER_ACCESS_TOKEN_MINUTES=15
RECEIVER_RATE_LIMIT_PER_MINUTE=600
RECEIVER_HEARTBEAT_SECONDS=30

# Retention of synced video on the receiver (days; 0 = delete as soon as the control room confirmed).
RECEIVER_RETENTION_AFTER_SYNC_DAYS=7
# Only ever removes video the control room has already confirmed.
RECEIVER_PURGE_SYNCED_ON_LOW_SPACE=false

# Optional site-local live view (a LiveKit server on the site LAN).
# RECEIVER_LOCAL_LIVEKIT_URL=wss://livekit.site.example
# RECEIVER_LOCAL_LIVEKIT_API_KEY_FILE=/etc/bodycam-receiver/livekit.key
# RECEIVER_LOCAL_LIVEKIT_API_SECRET_FILE=/etc/bodycam-receiver/livekit.secret

RECEIVER_LOG_LEVEL=INFO

# Plain-http central URLs are refused unless true (trusted private link or development only). Never use in production.
# RECEIVER_ALLOW_INSECURE_CENTRAL=false
# Point TMPDIR at the evidence volume: multipart uploads are spooled to the temp directory while they are parsed.
# TMPDIR=/var/lib/bodycam-receiver/tmp
