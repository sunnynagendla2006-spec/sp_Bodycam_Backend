# Backend environment configuration template.
#
# Copy this file to `.env` (same directory) for local `uvicorn` runs, or
# to a `.env` file next to docker-compose.yml for Docker Compose. NEVER
# commit a real .env file -- see .gitignore.
#
# Every variable below is read directly by the backend (confirmed via
# `grep -rn os.getenv app/`) -- nothing here is invented.

# --- Authentication (REQUIRED) ---------------------------------------------
# A long, random secret used to sign JWT access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset: the backend refuses to start when ENVIRONMENT=production
# (raises RuntimeError); in any other ENVIRONMENT it falls back to a
# well-known, INSECURE development secret and logs a loud warning. Never
# rely on that fallback outside local development.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Set to "production" to enforce strict startup checks (JWT_SECRET_KEY
# required, migration-head verification raises instead of warning).
# Defaults to "development" if unset.
ENVIRONMENT=development

# JWT signing algorithm and access-token lifetime. Both have safe
# defaults (HS256 / 60 minutes) and rarely need overriding.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (REQUIRED for anything beyond the built-in default) ---------
# Defaults to a Docker-network-friendly value
# (mongodb://mongo:27017/?replicaSet=rs0) -- override for local (non-Docker)
# development, e.g.:
#   mongodb://localhost:27017/?replicaSet=rs0
# The replica set is required (not optional) even for a single node: Motor/
# Beanie multi-document transactions (used for atomically writing an audit
# log row alongside its triggering state change) don't work on a standalone
# mongod. See docker-compose.yml's `mongo`/`mongo-init` services.
MONGODB_URL=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DB_NAME=police_db

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Defaults to "*" (any
# origin) if unset -- fine for quick local testing, but should be set to
# the real frontend origin(s) for anything beyond that, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=*

# --- Evidence / recording chunk storage -------------------------------------
# "local" (default) writes to disk at EVIDENCE_UPLOAD_ROOT; "s3" requires
# EVIDENCE_S3_BUCKET (and optionally EVIDENCE_S3_ENDPOINT_URL for
# S3-compatible services like MinIO -- leave unset for real AWS S3).
# EVIDENCE_S3_REGION/AWS_DEFAULT_REGION are also required for "s3": the
# former is used by live_stream.py's egress-to-S3 upload path, the latter
# by boto3 (see app/services/storage.py::S3StorageBackend).
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_UPLOAD_ROOT=/app/uploads
MAX_EVIDENCE_SIZE_MB=500
# EVIDENCE_S3_BUCKET=
# EVIDENCE_S3_ENDPOINT_URL=
# EVIDENCE_S3_REGION=
# EVIDENCE_S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# --- Live camera streaming (LiveKit) ----------------------------------------
# Live-only remote camera viewing (never recorded/stored) -- see
# app/routers/live_stream.py. Point these at a running `livekit-server`
# (a single binary, run with `livekit-server --dev` for local development,
# which prints a matching devkey/secret pair to use here).
LIVEKIT_URL=ws://localhost:7880
# `livekit-server --dev` prints a matching key/secret pair for local development.
# With ENVIRONMENT=production the backend refuses to start on the dev defaults.
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
# Internal, container-to-container addresses used ONLY for this backend's
# own egress start/stop calls and for the egress webhook URL it hands to
# LiveKit -- distinct from LIVEKIT_URL above, which is handed to real
# clients (phones/browsers) and must be a LAN-reachable address instead.
# Defaults already match the docker-compose service names.
LIVEKIT_INTERNAL_URL=ws://livekit:7880
BACKEND_INTERNAL_URL=http://backend:8000
#updated

# --- Misc ---------------------------------------------------------------
# How old a constable's last known location can be before it's considered
# stale for geofence-adjacent checks (seconds).
CONSTABLE_LOCATION_MAX_AGE_SECONDS=120

# --- Authorized CCTV monitoring (optional subsystem; admin/control_room
# only -- see app/routers/cctv.py) ------------------------------------------
# Set to "false" to remove the /cctv/* routes entirely (404) rather than
# leaving them mounted but non-functional.
CCTV_ENABLED=true
# Comma-separated CIDR allowlist of networks an authorized CCTV camera's
# stream_host is permitted to resolve to (see
# app/services/cctv_security.py::validate_stream_target). Certain ranges
# -- cloud metadata endpoints, multicast, unspecified -- are blocked
# unconditionally regardless of this list. Nothing is trusted by default:
# an EMPTY/unset value means no camera target can ever validate
# (fail-closed), including loopback/private ranges, which authorized CCTV
# commonly uses -- you must explicitly list the networks your cameras
# actually live on, e.g.:
#   CCTV_ALLOWED_NETWORKS=192.168.10.0/24,10.20.0.0/16
CCTV_ALLOWED_NETWORKS=
# Fernet key encrypting camera RTSP/VMS secrets at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Same production-required / dev-fallback-with-warning behavior as
# JWT_SECRET_KEY above (only enforced while CCTV_ENABLED is true) -- see
# app/services/cctv_security.py.
CCTV_SECRET_KEY=CHANGE_ME_GENERATE_WITH_FERNET
# Timeout for the RTSP connectivity probe used by POST
# /cctv/cameras/{id}/test (seconds).
CCTV_RTSP_CONNECT_TIMEOUT_SECONDS=5
CCTV_ONVIF_CONNECT_TIMEOUT_SECONDS=5

# --- CCTV media gateway (MediaMTX) and building dashboard ------------------
# See docs/CCTV_BUILDINGS_AND_GATEWAY.md and deploy/docker-compose.cctv.yml.
# Per-building networks (VPN subnets, a building's own public IP) are
# authorized by an admin on the building record, NOT by editing
# CCTV_ALLOWED_NETWORKS -- that global list stays as the baseline.
#
# Backend -> gateway control API. INTERNAL address only (never published).
CCTV_GATEWAY_API_URL=
# Where browsers reach the gateway's WebRTC/WHEP HTTP endpoint (public/TLS).
CCTV_GATEWAY_PUBLIC_URL=
# Shared secret in MediaMTX's external-auth callback URL; also used by the
# backend to refuse callbacks from anyone else. Generate a long random value.
CCTV_GATEWAY_AUTH_KEY=
# Optional dedicated signing secret for playback tokens (falls back to a value
# derived from JWT_SECRET_KEY). Playback tokens are NOT login tokens.
CCTV_PLAYBACK_TOKEN_SECRET=
# Playback token lifetime. WebRTC only checks it when a viewer connects.
CCTV_PLAYBACK_TOKEN_TTL_SECONDS=120
# Soft server-side cap on simultaneously watched cameras (gateway-reported).
CCTV_MAX_CONCURRENT_STREAMS=16
# Dwell time per camera in a building slot (seconds).
CCTV_ROTATION_SECONDS=5
# Optionally pre-connect the NEXT camera of each slot (bounded by the cap above).
CCTV_PREFETCH_NEXT=false
# Health monitor. Off by default: enable ONE instance's loop here, or call
# POST /cctv/buildings/health/run (admin) from an external scheduler.
CCTV_HEALTH_ENABLED=false
CCTV_HEALTH_INTERVAL_SECONDS=60
CCTV_HEALTH_MAX_BACKOFF_SECONDS=900
CCTV_HEALTH_CONCURRENCY=8
CCTV_HEALTH_PROBE_TIMEOUT_SECONDS=8

# --- AP-based police presence (optional feature) ---------------------------
# No dedicated environment variables for the base presence feature --
# presence_stale_seconds / presence_offline_seconds are runtime-configurable
# via POST /settings/ (admin only), the same mechanism as
# device_stale_seconds / device_offline_seconds already use. See
# app/services/presence.py::compute_effective_presence_status.
#
# Virtual AP mode (POST /presence/association/virtual, .../moving-ping) --
# see docs/VIRTUAL_AP_POLICE_PRESENCE.md. Simulates AP association for
# development/demonstration only; never a real Wi-Fi association. Defaults
# to enabled so the demo works out of the box -- set to "false" in any
# environment where frontend-driven movement simulation of a real
# officer's presence must not be possible.
# Ignored (always off) when ENVIRONMENT=production.
VIRTUAL_AP_MODE_ENABLED=false

# --- Edge Controller / Physical AP Telemetry (Stage 2) ---------------------
# Shared secret / API key required for physical edge collectors or AP
# controllers to ingest real Wi-Fi telemetry via POST /telemetry/ap-events.
# Never reuse constable JWT tokens for edge controllers. In production,
# set this to a long random secret and configure mutual TLS / firewall rules.
EDGE_CONTROLLER_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# Allowed clock skew for edge telemetry events (seconds). Rejects replay
# attacks and severely skewed timestamps.
EDGE_CONTROLLER_MAX_SKEW_SECONDS=300


# --- Officer tracking / duty sessions ---------------------------------------
# Freshness thresholds, measured from the fix's own recorded_at (seconds):
# live <= TRACKING_LIVE_SECONDS, delayed <= TRACKING_DELAYED_SECONDS,
# stale <= TRACKING_STALE_SECONDS, anything older is "unavailable".
TRACKING_LIVE_SECONDS=60
TRACKING_DELAYED_SECONDS=300
TRACKING_STALE_SECONDS=1800
# A fix received this long after it was recorded is labelled "buffered".
TRACKING_BUFFERED_AFTER_SECONDS=30
# Zone transitions: consecutive trusted fixes required, and the boundary margin
# (meters; effective margin = min(max(accuracy, MARGIN), MAX_MARGIN)).
ZONE_TRANSITION_CONFIRMATIONS=2
ZONE_BOUNDARY_MARGIN_METERS=10
ZONE_BOUNDARY_MAX_MARGIN_METERS=30
# Location history retention (days). A daily purge runs inside the API process
# unless LOCATION_RETENTION_LOOP=false (then run scripts/purge_location_history.py from cron).
LOCATION_RETENTION_DAYS=30
LOCATION_RETENTION_LOOP=true
LOCATION_RATE_LIMIT_PER_MINUTE=120
# Self-registered devices stay "pending" until an admin approves them.
# DEVICE_AUTO_APPROVE / ALLOW_MOCK_LOCATION are development conveniences and are
# ignored when ENVIRONMENT=production.
DEVICE_AUTO_APPROVE=false
ALLOW_MOCK_LOCATION=false
# Demo data is never created implicitly. Set true (development only) to seed
# demo APs/zones on first start, or run scripts/seed_*.py by hand.
SEED_DEMO_DATA=false
# Password used by the seed scripts (otherwise a random one is generated per run).
# SEED_PASSWORD=

# --- AP controller integration (optional; leave unset when none exists) ------
# Without AP_CONTROLLER_URL, access points can NOT be verified through a
# controller and the UI says so. Contract: docs/PHYSICAL_AP_INTEGRATION_GUIDE.md.
# AP_CONTROLLER_URL=https://controller.example.internal/api
# AP_CONTROLLER_TOKEN=
AP_CONTROLLER_TIMEOUT_SECONDS=5
# A verified AP with no telemetry for this long is reported "no recent telemetry".
AP_TELEMETRY_STALE_SECONDS=300

# --- Network monitoring platform (sites, collectors, occupancy) -------------
# See docs/NETWORK_MONITORING_PLATFORM.md.
# Keyed pseudonymization of client identifiers (MAC addresses). REQUIRED in
# production: without it, collector ingestion is refused (503). Generate a long
# random value and keep it secret; changing it changes every pseudonym.
CLIENT_ID_HMAC_KEY=
# Optional Fernet key. Only when set (and a site policy turns it on) are raw
# client identifiers stored, encrypted, for the admin-only "reveal" action.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLIENT_RAW_ID_KEY=
# Collector freshness: a collector not heard from for STALE seconds is "stale",
# for OFFLINE seconds is "offline".
COLLECTOR_STALE_SECONDS=180
COLLECTOR_OFFLINE_SECONDS=600
# Ingest safeguards.
COLLECTOR_RATE_LIMIT_PER_MINUTE=600
COLLECTOR_MAX_FUTURE_SKEW_SECONDS=300
COLLECTOR_MAX_EVENT_AGE_HOURS=72
# Periodic site evaluation (occupancy samples, threshold breaches, availability).
SITE_MONITOR_ENABLED=true
SITE_MONITOR_INTERVAL_SECONDS=30
SAMPLE_BUCKET_SECONDS=60
# Daily deletion of data older than each site's retention_days.
SITE_RETENTION_LOOP=true
# Floor plan upload limit.
FLOOR_PLAN_MAX_MB=10

# --- Bodycam offline transport / Network Hopping (see docs/BODYCAM_OFFLINE_TRANSPORT.md) ---
# Offline grants are ES256-signed by the control room only. Generate a key pair OFFLINE and keep the
# private key in a secret store (never in git); give receivers only the PUBLIC key.
#   openssl ecparam -name prime256v1 -genkey -noout -out grant_private.pem
#   openssl ec -in grant_private.pem -pubout -out grant_public.pem
# Without a signing key, grants cannot be issued (503) and Network Hopping provisioning is refused.
GRANT_SIGNING_PRIVATE_KEY_FILE=
# Alternative to the file: the PEM itself, with newlines written as \n.
GRANT_SIGNING_PRIVATE_KEY_PEM=
GRANT_SIGNING_KEY_ID=
GRANT_ISSUER=sp-bodycam-control-room
# How long an offline grant is valid (hours, 1-168). Revocation cannot reach an offline receiver, so keep it short.
GRANT_LIFETIME_HOURS=8
# Keep the exact bytes a phone uploaded as the original evidence; the watermarked file becomes a derivative.
PRESERVE_ORIGINAL_EVIDENCE=true
# Per-receiver request limit on /receiver/v1/*.
RECEIVER_RATE_LIMIT_PER_MINUTE=1200

# --- Bodycam transport: hardening settings (see docs/BODYCAM_OFFLINE_TRANSPORT.md, section 18) ---
# Receiver addresses handed to phones must be https. Set true ONLY in an isolated development lab; never in production.
ALLOW_HTTP_RECEIVER_ENDPOINTS=false
# How long expired offline-grant RECORDS are kept before scripts/purge_expired_offline_grants.py may remove them (days, min 7).
# The script is dry-run by default and is not scheduled by the application.
GRANT_RECORD_RETENTION_DAYS=90
# Upload bodies are spooled to the system temp directory while multipart is parsed: point TMPDIR at a volume with room for
# several chunks at once (MAX_EVIDENCE_SIZE_MB each), and set the same body limit in the reverse proxy.
# TMPDIR=/var/tmp/bodycam
