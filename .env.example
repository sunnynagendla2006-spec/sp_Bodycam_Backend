# Backend environment configuration template.
#
# Copy this file to `.env` (same directory) for local `uvicorn` runs, or
# to a `.env` file next to docker-compose.yml for Docker Compose. NEVER
# commit a real .env file -- see .gitignore.
#
# Every variable below is read directly by the backend (confirmed via
# `grep -rn os.getenv app/`) -- nothing here is invented.

# --- Authentication (REQUIRED) ---------------------------------------------
# A long, random secret used to sign JWT access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset: the backend refuses to start when ENVIRONMENT=production
# (raises RuntimeError); in any other ENVIRONMENT it falls back to a
# well-known, INSECURE development secret and logs a loud warning. Never
# rely on that fallback outside local development.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Set to "production" to enforce strict startup checks (JWT_SECRET_KEY
# required, migration-head verification raises instead of warning).
# Defaults to "development" if unset.
ENVIRONMENT=development

# JWT signing algorithm and access-token lifetime. Both have safe
# defaults (HS256 / 60 minutes) and rarely need overriding.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (REQUIRED for anything beyond the built-in default) ---------
# Defaults to a Docker-network-friendly value
# (postgresql+psycopg://postgres:postgres_password@db:5432/police_db) --
# override for local (non-Docker) development, e.g.:
#   postgresql+psycopg://postgres:postgres_password@localhost:5432/police_db
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@db:5432/police_db

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Defaults to "*" (any
# origin) if unset -- fine for quick local testing, but should be set to
# the real frontend origin(s) for anything beyond that, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=*

# --- Evidence / recording chunk storage -------------------------------------
# "local" (default) writes to disk at EVIDENCE_UPLOAD_ROOT; "s3" requires
# EVIDENCE_S3_BUCKET (and optionally EVIDENCE_S3_ENDPOINT_URL for
# S3-compatible services like MinIO).
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_UPLOAD_ROOT=/app/uploads
MAX_EVIDENCE_SIZE_MB=500
# EVIDENCE_S3_BUCKET=
# EVIDENCE_S3_ENDPOINT_URL=

# --- Live camera streaming (LiveKit) ----------------------------------------
# Live-only remote camera viewing (never recorded/stored) -- see
# app/routers/live_stream.py. Point these at a running `livekit-server`
# (a single binary, run with `livekit-server --dev` for local development,
# which prints a matching devkey/secret pair to use here).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Misc ---------------------------------------------------------------
# How old a constable's last known location can be before it's considered
# stale for geofence-adjacent checks (seconds).
CONSTABLE_LOCATION_MAX_AGE_SECONDS=120
